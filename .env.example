# Token que usa DeepSeek para autenticarse contra este proxy vía POST + header
# Authorization: Bearer (el modo "serio", para un orquestador con function-calling real)
PROXY_TOKEN=change_me_generate_a_random_64_char_string

# Token SEPARADO para /run (GET con ?token=), pensado para clientes que solo
# pueden hacer GET a una URL sin headers custom (ej. apps de chat que solo
# "leen páginas"). Va expuesto en la URL, por eso es distinto al de arriba:
# si se filtra en un log, no compromete el acceso vía Bearer.
GET_ACCESS_TOKEN=change_me_generate_another_random_64_char_string

# GitHub - fine-grained PAT, scope mínimo (Contents + Pull requests) sobre el repo objetivo
GITHUB_TOKEN=

# Railway API token (opcional, solo si usas las tools de deploy)
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

PORT=8080

# Token que usa DeepSeek para autenticarse contra este proxy (NO es el de GitHub)
PROXY_TOKEN=change_me_generate_a_random_64_char_string

# GitHub - fine-grained PAT, scope mínimo (Contents + Pull requests) sobre el repo objetivo
GITHUB_TOKEN=

# Railway API token (opcional, solo si usas las tools de deploy)
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

PORT=8080
